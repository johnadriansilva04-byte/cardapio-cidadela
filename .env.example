# Copie para `.env` e preencha com os dados do seu projeto Supabase.
# Estes valores são embutidos no bundle pelo Vite durante o build, portanto
# alterá-los exige reiniciar o dev server ou refazer o deploy.
#
# Na Vercel, cadastre as duas variáveis em Settings > Environment Variables.
# Para que previews de PR também funcionem, marque os ambientes
# Production *e* Preview — uma variável restrita à Production deixa o preview
# sem configuração e a tela de login exibe "Supabase não configurado".

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon