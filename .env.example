# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only (webhook/sync escrevem em admin_trials). Preferida.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Nome alternativo aceito no servidor (o código lê SUPABASE_ANON_KEY como
# fallback de VITE_SUPABASE_ANON_KEY). Só defina se precisar.
SUPABASE_ANON_KEY=

# Domínio público canônico do app (links de compartilhamento, QR, sitemap).
# Sem esta env, o código usa o fallback em src/lib/site.ts.
VITE_SITE_URL=

# Mercado Pago — Assinatura Premium (pagamento pontual anual)
# ATENÇÃO: o Access Token NÃO deve usar o prefixo VITE_ (seria exposto no
# bundle do cliente). Use a variável server-side abaixo.
MERCADOPAGO_ACCESS_TOKEN=
# Compatibilidade (evite): se só existir esta, ela é exposta no cliente.
VITE_MERCADOPAGO_ACCESS_TOKEN=
# Chave secreta do webhook (Mercado Pago > Webhooks). Valida o header x-signature.
# OBRIGATÓRIA: sem ela o webhook recusa toda notificação (503, fail-closed) — o
# endereço é público e sem assinatura qualquer um forjaria uma ativação.
MERCADOPAGO_WEBHOOK_SECRET=
# Só para dev local, quando não há como gerar a assinatura: libera o webhook sem
# secret. NUNCA defina em produção.
MERCADOPAGO_WEBHOOK_ALLOW_UNSIGNED=
# Link público de pagamento pontual (aceita Pix, cartão, boleto).
# Opcional/legado: o fluxo normal gera o link em /api/payment/create-link
# (com external_reference). Sem esta env o app não usa preferência fixa.
VITE_MERCADOPAGO_PAYMENT_LINK=
# Link estático de assinatura (usado como fallback quando o app não gera um
# link dinâmico com external_reference). Não vincula o pagamento à loja — o
# vínculo acontece pelo e-mail registrado em registerPendingSubscription.
VITE_MERCADOPAGO_SUBSCRIPTION_LINK=
# Valor do plano anual (usado para exibição na UI)
VITE_PREMIUM_ANNUAL_PRICE=R$ 199,99/ano
# Valor numérico efetivamente COBRADO pelo Mercado Pago (padrão: 199.99).
# Para um teste de cobrança pontual, defina 1 (e o rótulo acima como R$ 1,00/ano).
VITE_PREMIUM_PRICE_VALUE=

# --- Preços (modelo novo: nomes com ANNUAL/MONTHLY/DAY_PASS) ---
# Anual: valor numérico cobrado + rótulo exibido.
VITE_ANNUAL_PRICE_VALUE=
VITE_ANNUAL_PRICE_LABEL=
# Mensal (30 dias): valor numérico cobrado + rótulo exibido. Padrão: 28.99.
VITE_MONTHLY_PRICE_VALUE=
VITE_MONTHLY_PRICE_LABEL=
# Diária (24h): valor numérico cobrado + rótulo exibido. Padrão: 1.49.
# Para testar a cobrança com R$ 1,00, defina VITE_DAY_PASS_PRICE_VALUE=1 e
# VITE_DAY_PASS_PRICE_LABEL=R$ 1,00/dia. Lembre-se: VITE_* é embutido no BUILD,
# então mudar o valor exige um novo deploy para valer.
VITE_DAY_PASS_PRICE_VALUE=
VITE_DAY_PASS_PRICE_LABEL=

# --- Analytics (opcional) ---
# Sem esta env o módulo de analytics não envia nada. Só eventos/contagens, sem
# PII; o envio depende de consentimento por dispositivo (e respeita Do Not Track).
VITE_ANALYTICS_ENDPOINT=

# --- E2E (não defina em produção) ---
# VITE_E2E=1 desliga a regra de tempo mínimo do antispam e troca o SDK do
# Supabase pelo backend em memória. É setado automaticamente pelo Playwright.
VITE_E2E=
