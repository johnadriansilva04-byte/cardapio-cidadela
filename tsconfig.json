{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "eslint.config.js"],
  "exclude": [
    "src/components/cardapio/AdminModal.tsx",
    "src/components/cardapio/PaymentScreen.tsx",
    "src/components/cardapio/PremiumPaymentModal.tsx",
    "src/components/cardapio/VideoBonusModal.tsx",
    "src/components/cardapio/RobotWaiter.tsx",
    "src/components/cardapio/admin/DescontosConfig.tsx",
    "src/components/cardapio/admin/GerenciarCategorias.tsx",
    "src/components/cardapio/admin/GerenciarLanches.tsx",
    "src/components/cardapio/admin/GerenciarPedidos.tsx",
    "src/components/cardapio/admin/MenuPrincipal.tsx",
    "src/components/cidadela/BattleArena.tsx",
    "src/components/cidadela/CidadelaModal.tsx",
    "src/components/cidadela/CodeTimer.tsx",
    "src/components/cidadela/Config.tsx",
    "src/components/cidadela/Dashboard.tsx",
    "src/components/cidadela/FutebolBotao.tsx",
    "src/components/cidadela/IQTest.tsx",
    "src/components/cidadela/Pedidos.tsx",
    "src/components/cidadela/Praxinha.tsx",
    "src/components/cidadela/RobotLab.tsx",
    "src/components/cidadela/iq/*",
    "src/components/cidadela/map/*",
    "src/components/cidadela/Trilha/*",
    "src/components/battle/*",
    "src/lib/battle/*",
    "src/lib/iq/*",
    "src/lib/trilha/*",
    "src/modules/fluxos-n8n/*",
    "src/modules/pracinha-ai/*"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
